# i18n Service

PORT=3007
MONGODB_URI=mongodb://mongodb:27017/surebet_i18n
NODE_ENV=development

# Supported Languages (comma-separated)
SUPPORTED_LANGUAGES=en,fr,es,de,it,pt,nl
DEFAULT_LANGUAGE=en

# Cache Settings
TRANSLATION_CACHE_TTL=3600

# Feature Flags
ENABLE_FALLBACK_TRANSLATIONS=true
ENABLE_AUTO_DETECT_LANGUAGE=true
