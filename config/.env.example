# Surebet Detector Configuration

# The Odds API (for Unibet, Betclic, etc.)
# Get free API key at: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Forex API (free tier available)
# https://exchangerate-api.com/ or use frankfurter.app (no key needed)
FOREX_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Polymarket GraphQL Endpoint (public)
POLYMARKET_SUBGRAPH=https://api.thegraph.com/subgraphs/name/polymarket/matic-markets

# Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Update interval (cron format)
# Every hour: 0 * * * *
# Every 30 minutes: */30 * * * *
UPDATE_CRON=0 * * * *

# Minimum EV threshold to alert (percentage)
MIN_EV_THRESHOLD=5

# Sports to track (comma separated)
# Options: tennis, soccer, basketball, etc.
SPORTS=tennis,soccer

# Markets to track
# h2h = head to head (moneyline)
# outrights = futures/competitions
MARKETS=h2h,outrights
